# Don't resolve package versions published less than 3 days ago, so a
# compromised release has time to be caught before it reaches the lockfile.
# Only npm 11.10 or later reads this, and only when it resolves versions
# (npm install, npm update): the npm 10.9 bundled with Node 22 ignores it, and
# npm ci installs package-lock.json as-is.
min-release-age=3
